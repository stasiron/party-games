{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": true,
      "$roomId": {
        ".read": true,
        ".write": true,
        "gameId": {
          ".validate": "newData.isString() && newData.val().matches(/^(never-have-i-ever|truth-or-dare|impostor|mafia|dark-stories|who-would-rather|would-you-rather|kto-najpredzej)$/)"
        },
        "joinMode": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().matches(/^(public|password|invite)$/))"
        },
        "admission": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().matches(/^(open|closed|approval)$/))"
        },
        "showCodeInList": {
          ".validate": "newData.val() === null || newData.isBoolean()"
        },
        "isLocked": {
          ".validate": "newData.isBoolean()"
        },
        "isPrivate": {
          ".validate": "newData.val() === null || newData.isBoolean()"
        },
        "passwordHash": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/))"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "gameState": {
          ".validate": "newData.val() === null || newData.isString() || newData.isNumber() || newData.isBoolean() || newData.hasChildren()"
        },
        "settings": {
          ".validate": "newData.val() === null || newData.isString() || newData.isNumber() || newData.isBoolean() || newData.hasChildren()"
        },
        "roleHistory": {
          ".validate": "newData.val() === null || newData.isString() || newData.isNumber() || newData.isBoolean() || newData.hasChildren()"
        },
        "joinRequests": {
          "$requestId": {
            ".validate": "newData.val() === null || (newData.hasChildren(['name', 'requestedAt', 'status']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 24 && newData.child('requestedAt').isNumber() && newData.child('status').isString() && newData.child('status').val().matches(/^(pending|approved|rejected)$/))",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "authUid": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 128)"
            },
            "requestedAt": {
              ".validate": "newData.isNumber()"
            },
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(pending|approved|rejected)$/)"
            },
            "playerId": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 64)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "players": {
          "$playerId": {
            ".validate": "newData.val() === null || newData.hasChildren(['name', 'isHost', 'isOnline', 'isKicked'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "isHost": {
              ".validate": "newData.isBoolean()"
            },
            "isOnline": {
              ".validate": "newData.isBoolean()"
            },
            "isKicked": {
              ".validate": "newData.isBoolean()"
            },
            "isGuest": {
              ".validate": "newData.val() === null || newData.isBoolean()"
            },
            "linkedToPlayerId": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 64)"
            },
            "joinedAt": {
              ".validate": "newData.val() === null || newData.isNumber()"
            },
            "lastSeenAt": {
              ".validate": "newData.val() === null || newData.isNumber()"
            },
            "authUid": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 128)"
            },
            "leftAt": {
              ".validate": "newData.val() === null || newData.isNumber()"
            },
            "leaveReason": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().matches(/^(voluntary|disconnect|kicked)$/))"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomsPublic": {
      ".read": true,
      "$roomId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.val() === null || newData.hasChildren(['gameId', 'onlineCount', 'updatedAt'])",
        "gameId": {
          ".validate": "newData.isString() && newData.val().matches(/^(never-have-i-ever|truth-or-dare|impostor|mafia|dark-stories|who-would-rather|would-you-rather|kto-najpredzej)$/)"
        },
        "joinMode": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().matches(/^(public|password|invite)$/))"
        },
        "admission": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().matches(/^(open|closed|approval)$/))"
        },
        "showCodeInList": {
          ".validate": "newData.val() === null || newData.isBoolean()"
        },
        "isLocked": {
          ".validate": "newData.isBoolean()"
        },
        "onlineCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 64"
        },
        "pendingCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 64"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "hostName": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 24)"
        },
        "isPrivate": {
          ".validate": "newData.val() === null || newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "playerPresenceByAuthUid": {
      "$uid": {
        ".read": true,
        ".write": true,
        ".validate": "newData.val() === null || (newData.hasChildren(['roomId', 'playerId', 'updatedAt']) && newData.child('roomId').isString() && newData.child('roomId').val().length <= 16 && newData.child('playerId').isString() && newData.child('playerId').val().length <= 64 && newData.child('updatedAt').isNumber())",
        "$other": {
          ".validate": false
        }
      }
    },
    "_maintenance": {
      "roomsCleanupLease": {
        ".read": false,
        ".write": true,
        ".validate": "newData.val() === null || (newData.hasChildren(['owner', 'expiresAt', 'updatedAt']) && newData.child('owner').isString() && newData.child('owner').val().length > 0 && newData.child('owner').val().length <= 128 && newData.child('expiresAt').isNumber() && newData.child('updatedAt').isNumber())",
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
